# --- Adres aplikacji ---
APP_URL=https://studio.example.pl
AUTH_URL=https://studio.example.pl

# --- Logowanie: Microsoft Entra ID (aplikacja single-tenant w katalogu szkoły) ---
AUTH_SECRET=                                  # npx auth secret  (albo: openssl rand -base64 33)
AUTH_MICROSOFT_ENTRA_ID_ID=                   # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=               # Client secret (rotacja co 12 miesięcy)
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=cdeca4b5-7ade-4442-8dc2-2be7fd807b23   # do potwierdzenia w portalu Entra
ALLOWED_EMAIL_DOMAIN=mti.edu.pl

# Administratorzy awaryjni (oprócz roli Studio.Admin w Entra) i adresaci maili administracyjnych
ADMIN_EMAILS=szymonsujkowski@mti.edu.pl
ADMIN_NOTIFY_EMAILS=szymonsujkowski@mti.edu.pl

# --- Baza PostgreSQL (region Frankfurt) ---
DATABASE_URL=postgres://studio_app:HASLO@HOST:6543/postgres          # konto aplikacji (pooler)
DATABASE_URL_ADMIN=postgres://postgres:HASLO@HOST:5432/postgres      # tylko do migracji i importu, NIE na Vercelu

# --- Limity: Upstash Redis z Vercel Marketplace (zmienne dodają się same) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Maile: SMTP (bez administratora M365) — np. Gmail z hasłem aplikacji (2FA + myaccount.google.com/apppasswords) ---
MAIL_TRANSPORT=smtp                           # smtp | graph (domyślnie smtp, gdy ustawiono SMTP_HOST)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                                    # adres Gmail, z którego idą maile
SMTP_PASS=                                    # hasło aplikacji (16 znaków), NIE hasło do konta
MAIL_FROM="Studio wideo <adres@gmail.com>"

# --- Maile: Microsoft Graph, skrzynka studia (tylko gdy MAIL_TRANSPORT=graph i administrator zatwierdził Mail.Send) ---
STUDIO_MAILBOX=studio@mti.edu.pl
# Opcjonalnie osobna rejestracja do wysyłki (domyślnie ta sama co logowanie):
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_DISABLED=0                               # 1 = maile tylko w logu (pilotaż równolegle z Power Automate)

# --- Sekrety aplikacji ---
CRON_SECRET=                                  # openssl rand -hex 32
DOOR_SECRET=                                  # openssl rand -hex 32  (podpis kodu drzwi)
IP_HASH_SALT=                                 # openssl rand -hex 16

# --- Inne ---
ATTENDANCE_RETENTION_MONTHS=12
BOTID_DISABLED=0                              # 1 = awaryjne wyłączenie BotID
